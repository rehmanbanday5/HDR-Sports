# ============================================
# GULLY CRICKET - Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================

# --- Core ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/gully_cricket
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gully_cricket
MONGO_URI = mongodb+srv://hdr_sports_admin:HDRSPORTS321@hdr-sports.kgkst0h.mongodb.net/?appName=HDR-Sports

# --- Auth / JWT ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_DAYS=30

# --- Cloudinary (product image storage) ---
# Sign up free at https://cloudinary.com -> Dashboard gives you these three values.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (order confirmations / status updates) ---
# Any SMTP provider works: Gmail (App Password), SendGrid, Mailgun, Postmark, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="GULLY Cricket <orders@gullycricket.com>"
ADMIN_EMAIL=admin@gullycricket.com

# --- Payments ---
# Stripe (international cards) - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# JazzCash / EasyPaisa (Pakistani local payment gateways) - obtained from merchant onboarding
JAZZCASH_MERCHANT_ID=replace_me
JAZZCASH_PASSWORD=replace_me
JAZZCASH_INTEGRITY_SALT=replace_me
JAZZCASH_RETURN_URL=http://localhost:5173/payment/jazzcash/callback

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
